# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
API_KEY=nt04-network-admin-secret-token

# Database Configuration
# PostgreSQL (Production / LAN Central Server):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/network_intelligence

